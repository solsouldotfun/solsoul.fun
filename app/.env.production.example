# Production RPC endpoints.
# NEVER commit real API keys. Copy this file to an untracked .env.production
# and replace placeholders only in the deployment environment.
#
# Server-only paid primary + fallback. Do not use NEXT_PUBLIC_* for metered keys.
RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY,https://api.triton.one/YOUR_TRITON_TOKEN

# Browser wallet RPC must be public or proxied without exposing provider keys.
NEXT_PUBLIC_RPC=https://api.mainnet-beta.solana.com

# Sentry (optional). Keep blank unless a public frontend DSN is provisioned.
NEXT_PUBLIC_SENTRY_DSN=

# Runtime environment tag for Sentry and production diagnostics.
NEXT_PUBLIC_ENV=production

# Program ids — production deploys must match deployments/mainnet.json.
NEXT_PUBLIC_BONDING_CURVE_PROGRAM_ID=
NEXT_PUBLIC_SOUL_GENERATOR_PROGRAM_ID=
