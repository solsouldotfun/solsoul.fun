# Example environment file — SAFE placeholder values only.
# Copy to .env.local and fill in real values; never commit real secrets.

NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_BONDING_CURVE_PROGRAM_ID=YOUR_BONDING_CURVE_PROGRAM_ID
NEXT_PUBLIC_SOUL_GENERATOR_PROGRAM_ID=YOUR_SOUL_GENERATOR_PROGRAM_ID
NEXT_PUBLIC_ENV=devnet

# Paid RPC (leave blank / use placeholder until you have a key)
HELIUS_API_KEY=YOUR_HELIUS_API_KEY
TRITON_RPC_URL=https://YOUR_PROJECT.rpcpool.com/YOUR_API_KEY
QUICKNODE_RPC_URL=https://your-endpoint.quiknode.pro/YOUR_API_KEY/
PRIVATE_KEY=YOUR_WALLET_PRIVATE_KEY_BASE58
